diff --git a/tests/test_ingestion/test_downloader.py b/tests/test_ingestion/test_downloader.py
new file mode 100644
index 0000000..1dc6deb
--- /dev/null
+++ b/tests/test_ingestion/test_downloader.py
@@ -0,0 +1,27 @@
+import pytest
+import httpx
+from ygo_ultime_deck.ingestion.downloader import download_ygojson
+
+@pytest.mark.asyncio
+async def test_download_success(httpx_mock, tmp_path):
+    # Setup mock file
+    mock_file_content = b"fake zip content"
+    httpx_mock.add_response(url="https://json.yugioh.com/api/v0.6.0/aggregate.zip", content=mock_file_content)
+    
+    # Run the downloader
+    target_path = tmp_path / "cache" / "aggregate.zip"
+    await download_ygojson(target_path=target_path)
+    
+    # Assert file is downloaded
+    assert target_path.exists()
+    assert target_path.read_bytes() == mock_file_content
+
+@pytest.mark.asyncio
+async def test_download_failure(httpx_mock, tmp_path):
+    httpx_mock.add_exception(httpx.RequestError("Mock network error"))
+    
+    target_path = tmp_path / "cache" / "aggregate.zip"
+    
+    # Test that it raises a specific exception we can catch in CLI
+    with pytest.raises(httpx.RequestError):
+        await download_ygojson(target_path=target_path)
